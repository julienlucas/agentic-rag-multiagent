{
  "buildCommand": "mkdir -p frontend/public && rm -rf frontend/public/static && cp -r static frontend/public/static && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "echo 'Skipping root install'",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://RAILWAY_API_HOST/api/:path*" },
    { "source": "/_allauth/:path*", "destination": "https://RAILWAY_API_HOST/_allauth/:path*" },
    { "source": "/accounts/:path*", "destination": "https://RAILWAY_API_HOST/accounts/:path*" },
    { "source": "/((?!static/|assets/|fonts/).*)", "destination": "/index.html" }
  ]
}
